generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDIO
  CLIENT_ADMIN
  CLIENT_USER
  PARTNER
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String
  role        Role     @default(CLIENT_USER)
  image       String?
  active      Boolean  @default(true)
  permissions Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  name      String
  type      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  colors    Color[]
  logos     LogoFile[]
  elements  GraphicElement[]
  documents Document[]

  @@unique([type, name])
}

model Color {
  id         String    @id @default(cuid())
  name       String
  hex        String
  rgb        String
  cmyk       String
  pantone    String?
  order      Int       @default(0)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Typography {
  id          String   @id @default(cuid())
  name        String
  type        String
  googleFont  String?
  description String   @db.Text
  weights     String?
  downloadUrl String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LogoFile {
  id           String    @id @default(cuid())
  name         String
  description  String?   @db.Text
  colorMode    String
  format       String
  colorProfile String
  previewUrl   String?
  downloadUrl  String
  permission   String    @default("logo_basic")
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model GraphicElement {
  id           String    @id @default(cuid())
  name         String
  description  String    @db.Text
  previewUrl   String?
  format       String
  colorProfile String
  downloadUrl  String
  permission   String    @default("elements_basic")
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Document {
  id          String    @id @default(cuid())
  name        String
  description String?   @db.Text
  previewUrl  String?
  downloadUrl String
  permission  String    @default("doc_manual")
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model GuideLine {
  id        String   @id @default(cuid())
  title     String
  body      String   @db.Text
  imageUrl  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Content {
  id        String   @id @default(cuid())
  section   String   @unique
  title     String
  body      String   @db.Text
  updatedAt DateTime @updatedAt
}

model Settings {
  id           String  @id @default(cuid())
  brandName    String  @default("Instalsat")
  primaryColor String  @default("#003841")
  accentColor  String  @default("#E05829")
  bgLight      String  @default("#EEF5FF")
  bgMedium     String  @default("#DCE3EC")
  logoUrlDark  String?
  logoUrlLight String?
  fontFamily   String  @default("Rubik")
}
